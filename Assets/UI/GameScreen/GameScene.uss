.root {
    background-color: rgb(255, 255, 255);
    background-image: url("project://database/Assets/Textures/data-center-ai-texas-getty.jpg?fileID=2800000&guid=2e65f2805d8842848a444b662505126d&type=3#data-center-ai-texas-getty");
    flex-direction: column;
    align-items: center;
}

.mainmenu {
    min-width: 567px;
    align-items: auto;
    justify-content: space-around;
    padding-top: 176px;
    padding-right: 111px;
    padding-bottom: 174px;
    padding-left: 111px;
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    min-height: 567px;
}

.unity-button {
    flex-grow: 1;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    aspect-ratio: auto;
    color: rgb(0, 0, 0);
    background-color: rgb(35, 164, 143);
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    font-size: 34px;
    -unity-text-outline-width: 0;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-font-style: bold;
}