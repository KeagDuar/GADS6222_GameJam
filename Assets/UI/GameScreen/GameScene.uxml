<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/MainMenuUSS.uss?fileID=7433441132597879392&amp;guid=7a86b43d9b7d5ef42a2d09ea328d63f2&amp;type=3#MainMenuUSS"/>
    <ui:VisualElement name="Root" class="root" style="flex-grow: 1; background-image: none; background-color: rgba(255, 255, 255, 0);">
        <ui:VisualElement name="MainContainer" class="mainmenu" style="flex-grow: 1; width: 100%; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(0, 0, 0); overflow: visible; opacity: 1; justify-content: space-between; align-items: stretch; align-content: flex-start; visibility: visible; flex-direction: column-reverse; height: 100%; min-width: 100%; min-height: 100%; max-width: 100%; max-height: 100%; flex-shrink: 0; display: flex;">
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: flex-start; align-content: auto; align-self: auto; width: 100%; height: 50%; min-width: 100%; min-height: 50%; max-height: 50%; max-width: 100%; translate: 0 0%; position: absolute; top: 72%; left: 0;">
                <ui:Button text="Power Plant" name="Electricity" class="unity-button" style="top: auto; left: auto;"/>
                <ui:Button text="Water Treatement" name="Water" class="unity-button" style="top: auto;"/>
                <ui:Button text="Data Center" name="DataCenter" class="unity-button" style="top: auto; right: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="ResourceContainer" style="flex-grow: 1; align-items: auto; justify-content: space-between; align-self: auto; align-content: auto; flex-direction: row; flex-shrink: 0; width: 100%; top: -118%;">
                <ui:Label text="1000000W" name="lblElectricity" class="unity-label" style="top: auto; left: auto; color: rgb(255, 222, 0);"/>
                <ui:Label text="10000L" name="lblWater" style="top: auto; left: auto; color: rgb(0, 149, 255);"/>
                <ui:Label text="$100000" name="lblDataCenter" style="top: auto; left: auto; color: rgb(95, 255, 0);"/>
                <ui:Label text="100" name="lblEnvHealth" style="left: auto; top: auto; color: rgb(192, 85, 34);"/>
                <ui:Label text="100" name="lblOpinion" style="top: auto; left: auto; color: rgb(255, 0, 238);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="BuildingInfoPanel" class="BuildingInfoPanel" style="flex-grow: 1; width: auto; height: auto; background-color: rgba(0, 0, 0, 0.84); top: auto; display: none;">
            <ui:Label text="Cost: $150,000&#10;Produces: $0.6&#10;Consumes: 100,000W&#10;Consumes: 15L&#10;Public opinion: -0.5&#10;Environment health: -0.5" name="BuildingInfoLabel" style="color: rgb(255, 255, 255);"/>
        </ui:VisualElement>
        <ui:VisualElement name="QTEPanel" style="flex-grow: 1; position: absolute; height: 100%; width: 100%; background-color: rgb(0, 0, 0); display: flex;">
            <ui:Image source="project://database/Assets/Textures/femalestandingsil.png?fileID=2800000&amp;guid=aee9e06e32aa9c041a880e16cd67a088&amp;type=3#femalestandingsil" scale-mode="ScaleAndCrop" name="QTEImage" style="width: 100%; height: 100%;"/>
            <ui:VisualElement style="flex-grow: 1; position: absolute; top: 35px; left: 35px;">
                <ui:Label text="The data center you are about to &#10;build will destroy a womens&#10;family home." name="QTEText"/>
            </ui:VisualElement>
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; flex-direction: row; justify-content: space-between;">
                <ui:Button text="Place it anyway" name="BadButton" style="top: auto; left: auto;"/>
                <ui:Button text="Don&apos;t place it" name="GoodButton" style="top: auto; left: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
